rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isDriver() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }
    
    function isApprovedDriver() {
      return isDriver() && 
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status == 'approved';
    }

    function isClient() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/clients/$(request.auth.uid));
    }

    function isApprovedClient() {
      return isClient() && 
        get(/databases/$(database)/documents/clients/$(request.auth.uid)).data.status == 'approved';
    }

    // --- Collections ---

    // Admins: Full Access
    match /admins/{adminId} {
      allow read: if isSignedIn(); // Allow checking if admin exists? Or maybe restrict to self.
      allow write: if isAdmin(); // Only admins can manage admins
    }

    // Users (Fallback for incomplete signups)
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow owner or admins to write user documents
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Drivers
    match /drivers/{driverId} {
      // Admin can do anything
      // Public read (for clients to see driver details) - or maybe restricted to 'approved' drivers?
      // Let's allow authenticated users to read driver basic info.
      allow read: if isSignedIn();
      
      // Driver can create their own profile during signup
      allow create: if request.auth.uid == driverId;
      
      // Driver can update specific fields, or admins can update any driver doc (for approvals)
      // Allow top-level 'updatedAt' as well to support client-side online toggles
      // that set a last-modified timestamp.
      // Also allow any signed-in user to update rating fields
      allow update: if isAdmin() || (request.auth.uid == driverId && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastLocation', 'isOnline', 'activeRideId', 'fcmToken', 'updatedAt'])
      )) || (isSignedIn() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ratingAvg', 'ratingCount'])
      ));
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isSignedIn(); // Drivers need to see client info
      
      // Client can create their own profile during signup
      allow create: if request.auth.uid == clientId;
      
      // Allow client to update limited fields, or admins to update (for approvals)
      allow update: if isAdmin() || (request.auth.uid == clientId && (
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['personalInfo', 'fcmToken'])
      )) || (isSignedIn() && (
        // Allow any signed-in user to update rating fields on clients
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ratingAvg', 'ratingCount'])
      ))
    }

    // Vehicles (Linked to drivers)
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      // Drivers can create their own vehicles, admins can manage all
      allow create: if request.auth.uid == request.resource.data.driverId;
      allow write: if isAdmin();
    }

    // Stands & Areas & Pricing (Read-only for users, Admin write)
    match /stands/{standId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /areas/{areaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /pricing/{pricingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Rides
    match /rides/{rideId} {
      // Admin access
      allow read, write: if isAdmin();

      // Create: Client must be approved
      allow create: if request.auth.uid == request.resource.data.clientId 
                    && isApprovedClient()
                    && request.resource.data.status == 'requested';

      // Read: Participants OR drivers discovering available requests
      allow read: if (request.auth.uid == resource.data.clientId 
                      || request.auth.uid == resource.data.driverId)
                  || (isDriver() && resource.data.status == 'requested');

      // Update: admins and drivers can update
      allow update: if (isAdmin() || isDriver());
      
      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.clientId
                    || request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.driverId
                    || isAdmin();
        
        allow create: if (request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.clientId
                         || request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.driverId)
                         && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Ratings
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, write: if isAdmin();
    }
  }
}
